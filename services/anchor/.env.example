# Read-only upstream RPC used by Anvil to build a local fork.
FORK_URL=https://rh-mainnet.g.alchemy.com/v2/REPLACE_ME
FORK_BLOCK=116549770
LOCAL_FORK_RPC=http://127.0.0.1:8547
# Generate fresh keys for this fork; never commit real private keys.
WITNESS_KEY=
WITNESS_ADDRESS=
# Exact RPC hostnames; defaults to loopback if unset. Add a mainnet hostname explicitly
# only after full fork acceptance. An empty list denies every host. Chain stays 4663.
ALLOWED_RPC_HOSTS=127.0.0.1,localhost,[::1]
SIRO_ANCHOR_CHAIN_ID=4663
SIRO_ANCHOR_RPC=http://127.0.0.1:8547
SIRO_ANCHOR_ADDRESS=0xbf9f13791c1c5bcd6e342fb500c711e574fb04e0
SIRO_ANCHOR_DEPLOYMENT_BLOCK=116549770
SIRO_ANCHOR_CONFIRMATIONS=2
SIRO_ANCHOR_JOURNAL=./data/fork-anchor.jsonl
SIRO_LEDGER_BINARY=./target/debug/ledger.exe
# Public addresses only; WITNESS_ADDRESS must differ from both.
SIRO_OPERATOR_ADDRESS=
SIRO_ANCHOR_OWNER_ADDRESS=
# A future mainnet witness key needs its own funded balance. These keys are fork-only.
CREATOR_KEY=
CREATOR_ADDRESS=
DEPOSITOR_KEY=
DEPOSITOR_ADDRESS=
