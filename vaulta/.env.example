# Copy to .env and fill in. Never commit .env.
# Nothing here has a default that points at real funds: every address and key is yours to supply.

# ── RPC ──────────────────────────────────────────────────────────────────────
# Official public endpoints (docs.robinhood.com/chain/connecting):
#   mainnet  https://rpc.mainnet.chain.robinhood.com   (chain 4663)
#   testnet  https://rpc.testnet.chain.robinhood.com   (chain 46630)
# If your network cannot reach *.robinhood.com, use a provider endpoint instead
# (Alchemy, QuickNode, dRPC, PublicNode all serve chain 4663).
ROBINHOOD_RPC_URL=
ROBINHOOD_TESTNET_RPC_URL=

# ── Deployer (contracts/script) ──────────────────────────────────────────────
# Use a fresh key funded with a little ETH. Prefer `--ledger` or `--account` (cast wallet) over a raw key.
DEPLOYER_PRIVATE_KEY=

# ── Protocol addresses you must decide (Deploy.s.sol refuses to run without them) ──
# Safe multisig that owns the TimelockController (admin of the oracle, router registry, arena).
MULTISIG=
# Receives the 20% compute-fund share of fees.
COMPUTE_FUND=
# $VAULTA token and its Uniswap V2 pair against USDG (needed for BuybackBurn's TWAP).
VAULTA_TOKEN=
VAULTA_USDG_V2_PAIR=
# Receives the full $VAULTA supply when running DeployToken.s.sol.
TOKEN_RECIPIENT=

# ── Explorer verification (contracts/script/VerifyAll.sh) ────────────────────
# Blockscout needs no key. Set this only to also verify on robin.etherscan.io.
ETHERSCAN_API_KEY=
